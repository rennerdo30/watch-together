{
  "manifest_version": 2,
  "name": "Watch Together Cookie Sync",
  "version": "1.3.0",
  "description": "Sync cookies from YouTube, Twitch, Kick and other sites to Watch Together while your browser is open",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "idle",
    "tabs",
    "webRequest",
    "activeTab",
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://*.kick.com/*",
    "*://*.vimeo.com/*",
    "*://*.dailymotion.com/*",
    "*://*.crunchyroll.com/*",
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icons/icon.svg"
  }
}
