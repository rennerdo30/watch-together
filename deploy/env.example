# Copy to /opt/watch-together/.env on the host and fill in the secrets.
# Compose refuses to start without the values marked :?required.

# ── Public hostname behind the Cloudflare Tunnel ──────────────────────
WT_HOST=w2g.renner.dev

# ── Cloudflare Tunnel ─────────────────────────────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel →
#   Install connector → Docker → copy the long --token value.
# Then add a Public Hostname on that tunnel:
#   Subdomain: w2g   Domain: renner.dev   Service: HTTP  nginx:80
CLOUDFLARED_TOKEN=

# ── Identity (strongly recommended) ───────────────────────────────────
# With both set, the backend verifies the signed Cf-Access-Jwt-Assertion
# against your team's public keys instead of trusting the plain email
# header — which anyone who can reach the origin directly could forge.
# Setting both also turns REQUIRE_AUTHENTICATION on, so anonymous
# WebSocket and proxy requests are rejected.
#
# Cloudflare Zero Trust → Access → Applications → your app:
#   team domain is on Settings → Custom Pages (…cloudflareaccess.com)
#   AUD tag is on the application's Overview page
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Leave blank to follow CF_ACCESS_* (on when both are set). Set to
# "false" only if you deliberately want anonymous guests.
REQUIRE_AUTHENTICATION=

# ── Tunnel transport ──────────────────────────────────────────────────
# auto (QUIC with an HTTP/2 fallback), quic, or http2. QUIC handles packet
# loss on long-haul paths much better; set http2 only if UDP/443 is blocked
# for the host.
TUNNEL_PROTOCOL=auto

# ── DNS over HTTPS ────────────────────────────────────────────────────
# Every container resolves external names through an AdGuard dnsproxy
# sidecar that forwards to Cloudflare over HTTPS. It needs a fixed address
# inside the stack's subnet; change both together only if the default
# range collides with another network on the host. Changing them means
# recreating the network once: docker compose down && docker compose up -d
WT_SUBNET=172.28.0.0/24
WT_DNS_IP=172.28.0.53

# ── CORS ──────────────────────────────────────────────────────────────
# Defaults to https://$WT_HOST. Only widen this if something other than
# the site itself calls the API.
ALLOWED_ORIGINS=

# ── Segment cache ─────────────────────────────────────────────────────
# Budget for cached media, in GB. Once it is reached the proxy stops
# caching until the janitor evicts, so a budget smaller than a viewing
# session turns caching off partway through. 500 MB of free disk is kept
# free regardless.
MAX_CACHE_SIZE_GB=4

# ── Admin panel ───────────────────────────────────────────────────────
# Comma-separated verified identities allowed to use the admin panel at
# https://$WT_HOST/admin (rooms, viewers, cache inspection and clearing).
# Empty disables the panel entirely.
ADMIN_EMAILS=

# SponsorBlock API used to look up skippable segments of YouTube videos.
# Defaults to the public instance; set to a mirror or a stub if needed.
# SPONSORBLOCK_API_URL=https://sponsor.ajay.app

# ── Screen sharing ────────────────────────────────────────────────────
# A member's screen is carried by this server: the browser encodes it and
# pushes the chunks up a WebSocket, and the backend sends a copy to each
# viewer. Nothing has to be published on the host and there is nothing to
# configure — but the bandwidth is the server's, one copy per viewer, so
# a room of five on the default preset is about 40 Mbit/s of upload. The
# ceilings are SHARE_RELAY_MAX_ROOMS and SHARE_RELAY_MAX_VIEWERS in
# backend/core/config.py.

# ── Shared browser (neko) ─────────────────────────────────────────────
# A real browser running on the server, shown in the room's player, driven
# by whoever holds control. Off by default, and the only feature here that
# the tunnel cannot carry on its own: cloudflared moves HTTP and
# WebSocket, and this is WebRTC media. Until one of the two media paths
# below is configured the room says the feature is unavailable, and says
# why, instead of offering a button that cannot work.
#
# Start the container with `--profile browser`; without it neko does not
# run at all and the rest of the stack is unchanged.
# BROWSER_ENABLED=true
#
# Passwords for neko's member provider. They never reach a browser: the
# backend logs in over the internal network and hands each member the
# resulting session as a cookie scoped to /neko. The room's admin gets the
# admin session (control), everyone else the user session.
#   openssl rand -hex 24
# BROWSER_USER_PASSWORD=
# BROWSER_ADMIN_PASSWORD=
#
# Screen geometry of the virtual desktop.
# BROWSER_SCREEN=1920x1080@30
#
# --- media path A: open a UDP range on the host ----------------------
# Both values are needed. An announced address with nothing listening
# behind it is worse than no announcement: every viewer waits out an ICE
# timeout first. Publish the range with the overlay compose file
# (deploy/docker-compose.browser-udp.yml) and open it UDP in the host
# firewall *and* at the provider.
# BROWSER_UDP_PORTS=59000-59100
# BROWSER_PUBLIC_IP=203.0.113.10
#
# --- media path B: a TURN relay, nothing published -------------------
# Two settings, and both are needed. WEBRTC_TURN_URL is how this server
# knows a relay exists at all — without it the room reports the browser as
# unavailable rather than offering a button that opens a black rectangle.
# BROWSER_ICE_SERVERS is the same relay in the JSON shape neko expects,
# with the credentials; it is used as both the frontend and the backend
# ICE list, and both matter: the viewer needs the relay to find neko, and
# neko needs it to allocate an address of its own on a host with no open
# ports.
# WEBRTC_TURN_URL=turn:turn.example.net:3478
# BROWSER_ICE_SERVERS=[{"urls":"turn:turn.example.net:3478","username":"user","credential":"secret"}]
#
# Set to false only for a plain-HTTP development stack: a Secure cookie is
# not stored over http, and the embed would never authenticate.
# BROWSER_SESSION_COOKIE_SECURE=true
