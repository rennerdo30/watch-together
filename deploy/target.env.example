# Deployment target. Copy to deploy/target.env (gitignored) and fill in.
#
#   cp deploy/target.env.example deploy/target.env
#
# This file exists because the repository is public: the host address and
# login belong on your machine, not in the published history. sync.sh and
# deploy.sh read it automatically, so with it in place they still run with
# no arguments. --host=/--user=/--remote= flags override it.

# SSH login for the deployment host.
DEPLOY_USER=root
DEPLOY_HOST=your.server.ip.here

# Where the bundle lives on that host.
DEPLOY_REMOTE=/opt/watch-together
